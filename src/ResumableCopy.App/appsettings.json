{
  "ResumableCopy": {
    "Logging": {
      "MinimumLevel": "Information",
      "LogDirectory": "%LOCALAPPDATA%\\ResumableCopy\\logs"
    },
    "Copy": {
      "UseAdaptivePerformance": true,
      "VerifyWholeFileAfterCopy": true,
      "FlushEveryChunk": false
    },
    "Diagnostics": {
      "Level": "Normal",
      "MonitorUiResponsiveness": true,
      "UiStallThresholdMilliseconds": 500,
      "ProgressUpdateIntervalMilliseconds": 200,
      "DeviceProbeCacheMilliseconds": 2000,
      "ReconnectProbeIntervalMilliseconds": 1000
    },
    "Staging": {
      "CacheDirectoryName": ".copycache"
    }
  }
}
