<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="CommonControls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#AAAAAA" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#0A0A0A" />
    <SolidColorBrush x:Key="AppAccentBrush" Color="#3794FF" />
    <SolidColorBrush x:Key="AppOverlayBrush" Color="#99000000" />
    <SolidColorBrush x:Key="AppSettingsPanelBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="AppButtonBackgroundBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="AppButtonForegroundBrush" Color="#ECECEC" />
    <SolidColorBrush x:Key="AppButtonBorderBrush" Color="#141414" />
    <SolidColorBrush x:Key="AppButtonHoverBrush" Color="#484848" />
    <SolidColorBrush x:Key="AppButtonHoverBorderBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="AppButtonPressedBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="AppTabBackgroundBrush" Color="#252525" />
    <SolidColorBrush x:Key="AppTabSelectedBackgroundBrush" Color="#383838" />
    <SolidColorBrush x:Key="AppTabHoverBackgroundBrush" Color="#404040" />
    <SolidColorBrush x:Key="AppDataGridSelectionBrush" Color="#3A4A5A" />
    <SolidColorBrush x:Key="AppDataGridCellFocusBrush" Color="#404040" />

    <BitmapImage x:Key="AppLogoImage" UriSource="/Assets/logo-white.png" />

    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="RowBackground" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="AlternatingRowBackground" Value="#333333" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource AppBorderBrush}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#383838" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="#252525" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style TargetType="StatusBar">
        <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AppForegroundBrush}" />
    </Style>
</ResourceDictionary>
